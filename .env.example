# Скопируй в .env.local и заполни. Значения для локального Supabase печатает `npm run db:start`.

# Публичные (уходят в браузер)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Только сервер. Никогда не использовать в клиентских компонентах.
SUPABASE_SECRET_KEY=

# Публичный адрес бакета R2 со сценами залов и афишами
NEXT_PUBLIC_ASSETS_URL=
