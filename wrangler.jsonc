{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "rakurs",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		// Self-reference, имя должно совпадать с "name" выше. См. https://opennext.js.org/cloudflare/caching
		{ "binding": "WORKER_SELF_REFERENCE", "service": "rakurs" }
	],
	"r2_buckets": [
		// Кеш страниц Next.js. Создать до первого деплоя: npx wrangler r2 bucket create rakurs-opennext-cache
		{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "rakurs-opennext-cache" }
	],
	"images": { "binding": "IMAGES" }
}
